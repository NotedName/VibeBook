rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone must be signed in with a verified email address.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Friendships are stored once per pair under the two ids sorted and joined with "_".
    function isFriend(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a));
    }

    // Membership is one document per person and group, named "<groupId>_<uid>".
    function inMyGroup(gid) {
      return exists(/databases/$(database)/documents/groupMembers/$(gid + '_' + request.auth.uid));
    }

    // Roles in a group live on the member's document ("admin", "moderator" or "member"; none counts
    // as member). The group's owner is always an admin, even on documents from before roles existed.
    function groupOwner(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid; }
    function roleIn(gid, uid) {
      return exists(/databases/$(database)/documents/groupMembers/$(gid + '_' + uid))
        ? get(/databases/$(database)/documents/groupMembers/$(gid + '_' + uid)).data.get('role', 'member')
        : '';
    }
    function isAdminOf(gid) { return signedIn() && (groupOwner(gid) == request.auth.uid || roleIn(gid, request.auth.uid) == 'admin'); }
    function isModOf(gid) { return signedIn() && roleIn(gid, request.auth.uid) == 'moderator'; }

    // An entry lists the groups it is shared to in groupIds. Rules cannot loop, so only the
    // first five are checked (the app never saves more than five).
    function sharedWithMyGroup(entry) {
      let g = entry.get('groupIds', []);
      return (g.size() > 0 && inMyGroup(g[0]))
        || (g.size() > 1 && inMyGroup(g[1]))
        || (g.size() > 2 && inMyGroup(g[2]))
        || (g.size() > 3 && inMyGroup(g[3]))
        || (g.size() > 4 && inMyGroup(g[4]));
    }

    // For photos and comments, which hang off an entry: can the signed-in person see the entry?
    function entryReadable(uid, entryId) {
      let e = get(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)).data;
      return e.get('visibility', 'private') == 'public'
        || (e.get('visibility', 'private') == 'friends' && isFriend(request.auth.uid, uid))
        || sharedWithMyGroup(e);
    }

    // Public entries can be opened without signing in, but only by someone who already has the
    // entry's link (unguessable id). Signed-out visitors get "get" on one entry, and read on its
    // photos, comments and reactions. They cannot list entries, so nothing can be browsed, and
    // they cannot write anything.
    function entryIsPublic(uid, entryId) {
      return get(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)).data.get('visibility', 'private') == 'public';
    }

    // A repost puts someone else's public entry in your own logbook (and optionally in groups you
    // are in). It is a pointer, named "<ownerUid>_<entryId>"; the entry stays where it is. Anyone
    // signed in can read the pointers (the entry itself is still checked by its own rules), only
    // you can write yours, and only public entries of other people can be reposted.
    match /users/{uid}/reposts/{repostId} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'entryId', 'date', 'time', 'groupIds', 'createdAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.entryId is string
        && request.resource.data.ownerUid != uid
        && repostId == request.resource.data.ownerUid + '_' + request.resource.data.entryId
        && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 5
        && request.resource.data.createdAt == request.time
        && entryIsPublic(request.resource.data.ownerUid, request.resource.data.entryId);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds'])
        && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 5;
      allow delete: if isOwner(uid);
    }

    // Teasers: a tiny note that one of your entries was posted to a PRIVATE group, so your profile can say
    // "join the group to see this post" instead of showing it. It holds only the entry id, the date and the
    // private group ids, never the entry's text or photos. Any signed-in person can read them; only you write them.
    match /users/{uid}/teasers/{entryId} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['entryId', 'groupIds', 'date', 'time'])
        && request.resource.data.entryId == entryId
        && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 5
        && request.resource.data.date is string
        && request.resource.data.time is string;
      allow delete: if isOwner(uid);
    }

    // Your Likes list: a private pointer, named "<ownerUid>_<entryId>", to every entry you gave a Vibing.
    // Only you can read or write it, and only for entries you can see.
    match /users/{uid}/likes/{likeId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'entryId', 'createdAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.entryId is string
        && likeId == request.resource.data.ownerUid + '_' + request.resource.data.entryId
        && request.resource.data.createdAt == request.time
        && (request.resource.data.ownerUid == uid
            || entryReadable(request.resource.data.ownerUid, request.resource.data.entryId));
      allow delete: if isOwner(uid);
    }

    // Friends list others can open: one pointer per friend at users/{uid}/friendList/{friendUid}. Each person
    // keeps their own list in step with their real friendships (the app does it), and a pointer can only be
    // written for someone you are friends with. Anyone signed in can read it unless the owner turned off
    // "friendsVisible" on their profile (Settings > Privacy); the owner always can. A friend can remove
    // themselves from your list, so unfriending cannot leave a stale entry behind.
    match /users/{uid}/friendList/{friendId} {
      allow read: if isOwner(uid)
        || (signedIn() && get(/databases/$(database)/documents/profiles/$(uid)).data.get('friendsVisible', true) == true);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && isFriend(uid, friendId);
      allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == friendId);
    }

    // Notifications for {uid}: requests, likes, comments, reposts and the like. The person who did the
    // thing writes it (so it is created by someone else, as themselves), and its id starts with their
    // uid so nobody can overwrite another person's. The recipient reads them, marks them read and
    // deletes them; the writer can take theirs back (an undone like or a cancelled request).
    match /users/{uid}/notifications/{noteId} {
      allow read: if isOwner(uid);
      allow create: if signedIn()
        && request.auth.uid != uid
        && noteId.matches('^' + request.auth.uid + '_.{1,300}$')
        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'ownerUid', 'entryId', 'photoId', 'title', 'groupId', 'groupName', 'createdAt', 'read'])
        && request.resource.data.type in ['friend_request', 'friend_accept', 'follow', 'group_invite', 'group_request', 'group_approved', 'like', 'comment', 'reply', 'comment_like', 'repost']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('title', '').size() <= 140
        && request.resource.data.get('groupName', '').size() <= 60
        && request.resource.data.get('ownerUid', '').size() <= 128
        && request.resource.data.get('entryId', '').size() <= 128
        && request.resource.data.get('photoId', '').size() <= 128
        && request.resource.data.get('groupId', '').size() <= 128;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(uid) || (signedIn() && resource.data.actorUid == request.auth.uid);
    }

    // Activity log: one small document per action you take, at users/{uid}/activity/{id}, so the log follows you to every
    // device. Only you can read it. It is append-only: nothing can be changed or deleted, and re-saving an item that is
    // already there with the same content is allowed so a device can safely upload its older log again.
    match /users/{uid}/activity/{itemId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && itemId.size() <= 60
        && request.resource.data.keys().hasAll(['at', 'text'])
        && request.resource.data.keys().hasOnly(['at', 'text', 'who', 'href'])
        && request.resource.data.at is number
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.get('who', '') is string
        && request.resource.data.get('who', '').size() <= 128
        && request.resource.data.get('href', '') is string
        && request.resource.data.get('href', '').size() <= 200;
      allow update: if isOwner(uid) && request.resource.data == resource.data;
      allow delete: if false;
    }

    // Hours: private documents that follow you to every device. Only you can read or write them, except 'shared'.
    //  - goal:   { requiredHours, workDays, daysOff, daysOn, hoursPerDay }: the hours your school or company requires
    //            (1 to 10000, may have decimals; absent when no goal is set) and which days you can work. workDays are
    //            weekday numbers 0 to 6; daysOff and daysOn are dates that differ from the usual week (400 at most each);
    //  - clock:  { date, time }: the moment you clocked in, present only while the clock is running;
    //  - report: the lines printed at the top of exported Word and PDF reports (names, school), each up to 120 characters;
    //  - shared: { minutes, requiredMinutes }: the total you have logged and the total required, which anyone signed in can read
    //            only while "hoursVisible" is on on your profile (Settings > Privacy). The app keeps it in step and deletes it when
    //            the setting is turned off.
    // The hours worked are on the entries themselves (clockIn, clockOut, minutes).
    match /users/{uid}/hours/{docId} {
      allow read: if isOwner(uid)
        || (docId == 'shared' && signedIn()
            && get(/databases/$(database)/documents/profiles/$(uid)).data.get('hoursVisible', false) == true);
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && (
        (docId == 'goal'
          && request.resource.data.keys().hasOnly(['requiredHours', 'workDays', 'daysOff', 'daysOn', 'hoursPerDay'])
          && request.resource.data.get('requiredHours', 1) is number
          && request.resource.data.get('requiredHours', 1) > 0
          && request.resource.data.get('requiredHours', 1) <= 10000
          && request.resource.data.get('workDays', []) is list && request.resource.data.get('workDays', []).size() <= 7
          && request.resource.data.get('daysOff', []) is list && request.resource.data.get('daysOff', []).size() <= 400
          && request.resource.data.get('daysOn', []) is list && request.resource.data.get('daysOn', []).size() <= 400
          && request.resource.data.get('hoursPerDay', 8) is number
          && request.resource.data.get('hoursPerDay', 8) > 0
          && request.resource.data.get('hoursPerDay', 8) <= 24)
        || (docId == 'clock'
          && request.resource.data.keys().hasOnly(['date', 'time'])
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.time is string && request.resource.data.time.size() == 5)
        || (docId == 'report'
          && request.resource.data.keys().hasOnly(['traineeName', 'course', 'term', 'school', 'department', 'program', 'schoolYear'])
          && request.resource.data.get('traineeName', '') is string && request.resource.data.get('traineeName', '').size() <= 120
          && request.resource.data.get('course', '') is string && request.resource.data.get('course', '').size() <= 120
          && request.resource.data.get('term', '') is string && request.resource.data.get('term', '').size() <= 120
          && request.resource.data.get('school', '') is string && request.resource.data.get('school', '').size() <= 120
          && request.resource.data.get('department', '') is string && request.resource.data.get('department', '').size() <= 120
          && request.resource.data.get('program', '') is string && request.resource.data.get('program', '').size() <= 120
          && request.resource.data.get('schoolYear', '') is string && request.resource.data.get('schoolYear', '').size() <= 120)
        || (docId == 'shared'
          && request.resource.data.keys().hasOnly(['minutes', 'requiredMinutes'])
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1000000
          && request.resource.data.get('requiredMinutes', 1) is number
          && request.resource.data.get('requiredMinutes', 1) > 0
          && request.resource.data.get('requiredMinutes', 1) <= 600000)
      );
    }

    match /users/{uid}/following/{targetId} {
      allow read, write: if isOwner(uid);
    }

    // Other people can read an entry only when its owner shared it with them: publicly, with
    // friends, or with a group they are in. Entries with no visibility field are private.
    // Text limits for an entry: activity 140, description 2000, at most 15 skills. An edit that does not touch the
    // text (sharing to a group, say) is never blocked, so entries written before the limits stay editable.
    function entryTextOk(d) {
      return d.get('title', '').size() <= 140
        && d.get('description', '').size() <= 2000
        && d.get('skills', []).size() <= 15;
    }

    match /users/{uid}/entries/{entryId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && entryTextOk(request.resource.data);
      allow update: if isOwner(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'skills'])
            || entryTextOk(request.resource.data));
      allow get: if resource.data.get('visibility', 'private') == 'public';
      allow read: if signedIn() && (
        resource.data.visibility == 'public' ||
        (resource.data.visibility == 'friends' && isFriend(request.auth.uid, uid)) ||
        sharedWithMyGroup(resource.data)
      );

      match /photos/{photoId} {
        allow read, write: if isOwner(uid);
        allow read: if signedIn() && entryReadable(uid, entryId);
        allow read: if entryIsPublic(uid, entryId);

        // Each photo has its own reactions and comments, with the same rules as the entry's: whoever can
        // see the entry can react, comment and reply, and the photo has to exist. Photos are removed
        // with their entry by the app, so those documents go with them.
        // Anyone who can read the entry can comment and reply (parentId is "" or an existing comment)
        // and like. A comment can be deleted by its author or by the owner of the entry. Text cannot
        // be edited; the only updates are a like or unlike of your own, or blanking a comment that
        // has replies to "[deleted]". A comment can carry a sticker or GIF instead of, or as well as, text.
        match /comments/{commentId} {
          // After an update, the likes list differs from before by at most the signed-in person's own uid.
          function onlyMyLikeChanged() {
            let before = resource.data.get('likes', []).toSet();
            let after = request.resource.data.likes.toSet();
            return request.resource.data.likes is list
              && request.resource.data.likes.size() == after.size()
              && after.difference(before).hasOnly([request.auth.uid])
              && before.difference(after).hasOnly([request.auth.uid]);
          }

          allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
          allow read: if entryIsPublic(uid, entryId);
          allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['authorUid', 'text', 'sticker', 'gif', 'createdAt', 'parentId', 'likes'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.parentId is string
            && request.resource.data.parentId.size() <= 40
            && (request.resource.data.parentId == ''
                || exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/photos/$(photoId)/comments/$(request.resource.data.parentId)))
            && request.resource.data.likes == []
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 500
            && request.resource.data.sticker is string
            && request.resource.data.sticker.size() <= 16
            && request.resource.data.gif is string
            && request.resource.data.gif.size() <= 300
            // GIFs may only be loaded from Giphy or Tenor over https (keep in step with src/stickers.ts).
            && (request.resource.data.gif == ''
                || request.resource.data.gif.matches('^https://(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com)/.*'))
            // a comment needs some text, a sticker or a GIF
            && (request.resource.data.text.size() > 0
                || request.resource.data.sticker.size() > 0
                || request.resource.data.gif.size() > 0)
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/photos/$(photoId))
            && (request.auth.uid == uid || entryReadable(uid, entryId));
          allow update: if signedIn() && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && (request.auth.uid == uid || entryReadable(uid, entryId))
              && onlyMyLikeChanged())
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'sticker', 'gif', 'deleted'])
              && request.resource.data.text == ''
              && request.resource.data.get('sticker', '') == ''
              && request.resource.data.get('gif', '') == ''
              && request.resource.data.deleted == true
              && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid))
          );
          allow delete: if signedIn() && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid);
        }

        // One document per person, named by their uid, so nobody can react twice. "vibing" or
        // "notvibing". Anyone who can see the entry can react; you can only touch your own reaction,
        // and the entry's owner can remove any.
        match /reactions/{reactorId} {
          allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
          allow read: if entryIsPublic(uid, entryId);
          allow create, update: if signedIn()
            && request.auth.uid == reactorId
            && request.resource.data.keys().hasOnly(['type', 'createdAt'])
            && request.resource.data.type in ['vibing', 'notvibing']
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/photos/$(photoId))
            && (request.auth.uid == uid || entryReadable(uid, entryId));
          allow delete: if signedIn() && (request.auth.uid == reactorId || request.auth.uid == uid);
        }
      }

      // Anyone who can read the entry can comment and reply (parentId is "" or an existing comment)
      // and like. A comment can be deleted by its author or by the owner of the entry. Text cannot
      // be edited; the only updates are a like or unlike of your own, or blanking a comment that
      // has replies to "[deleted]". A comment can carry a sticker or GIF instead of, or as well as, text.
      match /comments/{commentId} {
        // After an update, the likes list differs from before by at most the signed-in person's own uid.
        function onlyMyLikeChanged() {
          let before = resource.data.get('likes', []).toSet();
          let after = request.resource.data.likes.toSet();
          return request.resource.data.likes is list
            && request.resource.data.likes.size() == after.size()
            && after.difference(before).hasOnly([request.auth.uid])
            && before.difference(after).hasOnly([request.auth.uid]);
        }

        allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
        allow read: if entryIsPublic(uid, entryId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'text', 'sticker', 'gif', 'createdAt', 'parentId', 'likes'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentId is string
          && request.resource.data.parentId.size() <= 40
          && (request.resource.data.parentId == ''
              || exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/comments/$(request.resource.data.parentId)))
          && request.resource.data.likes == []
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.sticker is string
          && request.resource.data.sticker.size() <= 16
          && request.resource.data.gif is string
          && request.resource.data.gif.size() <= 300
          // GIFs may only be loaded from Giphy or Tenor over https (keep in step with src/stickers.ts).
          && (request.resource.data.gif == ''
              || request.resource.data.gif.matches('^https://(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com)/.*'))
          // a comment needs some text, a sticker or a GIF
          && (request.resource.data.text.size() > 0
              || request.resource.data.sticker.size() > 0
              || request.resource.data.gif.size() > 0)
          && request.resource.data.createdAt == request.time
          && (request.auth.uid == uid || entryReadable(uid, entryId));
        allow update: if signedIn() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && (request.auth.uid == uid || entryReadable(uid, entryId))
            && onlyMyLikeChanged())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'sticker', 'gif', 'deleted'])
            && request.resource.data.text == ''
            && request.resource.data.get('sticker', '') == ''
            && request.resource.data.get('gif', '') == ''
            && request.resource.data.deleted == true
            && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid))
        );
        allow delete: if signedIn() && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid);
      }

      // One document per person, named by their uid, so nobody can react twice. "vibing" or
      // "notvibing". Anyone who can see the entry can react; you can only touch your own reaction,
      // and the entry's owner can remove any.
      match /reactions/{reactorId} {
        allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
        allow read: if entryIsPublic(uid, entryId);
        allow create, update: if signedIn()
          && request.auth.uid == reactorId
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['vibing', 'notvibing']
          && request.resource.data.createdAt == request.time
          && (request.auth.uid == uid || entryReadable(uid, entryId));
        allow delete: if signedIn() && (request.auth.uid == reactorId || request.auth.uid == uid);
      }
    }

    // Usernames. One document per name, and the document id IS the name (lowercase letters, numbers and
    // underscores, 3 to 20 long), so a name can only ever belong to one person. It can be created only
    // while nobody holds it (a create on an existing document counts as an update, which is not allowed),
    // and only released by the person it belongs to.
    //  - get: anyone, even signed out, so the sign-up form can say "taken" and profile links can find the person.
    //  - list: only your own, which is how profile setup finds the name you picked at sign-up.
    //  - create: verified accounts only, so unconfirmed or throwaway sign-ups can never hold a name.
    match /usernames/{name} {
      allow get: if true;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A profile's username must be one it owns. getAfter() sees the usernames document written in the same
    // transaction. Profiles from before usernames existed keep an empty one until their owner picks a name.
    function usernameOk(uid) {
      let d = request.resource.data;
      return d.username is string && (
        (d.username.matches('^[a-z0-9_]{3,20}$')
          && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == uid)
        || (d.username == '' && resource != null && resource.data.get('username', '') == '')
      );
    }

    // Public profile cards. Any signed-in person can read them (that is how search works);
    // only the owner can write theirs. The email address is never stored here.
    match /profiles/{uid} {
      allow read: if signedIn();
      // Lets a share link show the author's name and photo to signed-out visitors. Only a single
      // profile can be fetched by id; searching and listing still need an account.
      allow get: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && usernameOk(uid)
        && request.resource.data.bio.size() <= 300
        && request.resource.data.avatar.size() <= 120000
        && request.resource.data.coverPhoto.size() <= 120000
        && request.resource.data.get('friendsVisible', true) is bool
        && request.resource.data.get('hoursVisible', false) is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Any signed-in person can find a group and open its page. Public groups (privacy missing or "public")
    // can be joined by anyone; private groups need an invitation or an approved request (see groupMembers).
    // Up to five questions can be asked of people requesting to join a private group.
    function privacyOk(d) {
      return d.get('privacy', 'public') in ['public', 'private']
        && d.get('questions', []) is list
        && d.get('questions', []).size() <= 5;
    }
    function groupIsOpen(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data.get('privacy', 'public') == 'public'; }

    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && privacyOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.get('avatar', '').size() <= 120000
        && request.resource.data.get('coverPhoto', '').size() <= 120000;

      // Only an admin can edit the group's name, description and photos. The owner never changes.
      allow update: if isAdminOf(gid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameKeys', 'description', 'avatar', 'coverPhoto', 'privacy', 'questions'])
        && privacyOk(request.resource.data)
        && request.resource.data.get('avatar', '').size() <= 120000
        && request.resource.data.get('coverPhoto', '').size() <= 120000
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300;

      // Requests to join a private group, named by the requester's uid. Only that person can send one (in their own
      // name, to a private group, with a "why" message of 1 to 300 characters and one answer per question), and only
      // they and the group's admins and moderators can read or delete it. Approving is an admin or moderator creating
      // the membership (see groupMembers) and deleting the request.
      match /requests/{requestUid} {
        allow read: if isAdminOf(gid) || isModOf(gid) || (signedIn() && request.auth.uid == requestUid);
        allow create: if signedIn()
          && request.auth.uid == requestUid
          && request.resource.data.keys().hasOnly(['message', 'answers', 'createdAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 300
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 5
          && request.resource.data.createdAt == request.time
          && !groupIsOpen(gid)
          && !inMyGroup(gid)
          && !exists(/databases/$(database)/documents/groups/$(gid)/bans/$(request.auth.uid));
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == requestUid || isAdminOf(gid) || isModOf(gid));
      }

      // People removed from the group, named by their uid. They cannot join again until an admin
      // deletes this. Admins can bar anyone but the owner; moderators only current plain members.
      match /bans/{bannedUid} {
        allow read: if isAdminOf(gid) || isModOf(gid) || (signedIn() && request.auth.uid == bannedUid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['by', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && bannedUid != groupOwner(gid)
          && bannedUid != request.auth.uid
          && (isAdminOf(gid) || (isModOf(gid) && roleIn(gid, bannedUid) == 'member'));
        allow delete: if isAdminOf(gid);
      }

      // Lists an entry in the group's feed. Only members can add to it, in one of two ways:
      //  - their own entry, named "<ownerUid>_<entryId>";
      //  - a repost of someone else's public entry, named "<me>_rp_<ownerUid>_<entryId>", with
      //    repostedBy set to themselves.
      // Whoever added a post can always take it out again, and so can the group's admins and moderators.
      match /posts/{postId} {
        allow read: if signedIn() && inMyGroup(gid);
        allow create, update: if signedIn() && inMyGroup(gid)
          && (
            (request.resource.data.get('repostedBy', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
              && postId == request.auth.uid + '_' + request.resource.data.entryId)
            || (request.resource.data.get('repostedBy', '') == request.auth.uid
              && request.resource.data.keys().hasOnly(['ownerUid', 'entryId', 'date', 'time', 'repostedBy'])
              && request.resource.data.ownerUid is string
              && request.resource.data.ownerUid != request.auth.uid
              && postId == request.auth.uid + '_rp_' + request.resource.data.ownerUid + '_' + request.resource.data.entryId
              // an entry is in a group once: no repost into a group that already has the original post
              && !exists(/databases/$(database)/documents/groups/$(gid)/posts/$(request.resource.data.ownerUid + '_' + request.resource.data.entryId))
              && entryIsPublic(request.resource.data.ownerUid, request.resource.data.entryId))
          );
        allow delete: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || resource.data.get('repostedBy', '') == request.auth.uid
              || isAdminOf(gid) || isModOf(gid));
      }
    }

    // Joining, in three ways:
    //  - for yourself, into a public group, or into a private group you were invited to (as a member, unless barred);
    //  - an admin or moderator letting in someone who asked to join a private group (their request must exist);
    //  - the group's owner creating it, together with the group, as its first member and admin.
    // Anyone can leave for themselves, except the group's owner, who stays. Joining requires the group to exist after
    // the write, so creating a group and its first member can be one batch.
    // Admins change roles (never the owner's, never their own). Admins remove anyone but the
    // owner, and moderators remove plain members.
    match /groupMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'uid', 'joinedAt', 'role'])
        && request.resource.data.uid is string
        && memberId == request.resource.data.groupId + '_' + request.resource.data.uid
        && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/bans/$(request.resource.data.uid))
        && (
          (request.resource.data.uid == request.auth.uid
            && request.resource.data.get('role', 'member') == 'member'
            && (groupIsOpen(request.resource.data.groupId)
                || exists(/databases/$(database)/documents/groupInvites/$(request.resource.data.groupId + '_' + request.auth.uid))))
          || (request.resource.data.uid == request.auth.uid
              && request.resource.data.get('role', 'member') == 'admin'
              && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid)
          || (request.resource.data.uid != request.auth.uid
              && request.resource.data.get('role', 'member') == 'member'
              && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/requests/$(request.resource.data.uid))
              && (isAdminOf(request.resource.data.groupId) || isModOf(request.resource.data.groupId)))
        );
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['admin', 'moderator', 'member']
        && resource.data.uid != groupOwner(resource.data.groupId)
        && resource.data.uid != request.auth.uid
        && isAdminOf(resource.data.groupId);
      allow delete: if signedIn() && (
        (resource.data.uid == request.auth.uid && groupOwner(resource.data.groupId) != request.auth.uid)
        || (resource.data.uid != groupOwner(resource.data.groupId)
            && resource.data.uid != request.auth.uid
            && (isAdminOf(resource.data.groupId)
                || (isModOf(resource.data.groupId) && resource.data.get('role', 'member') == 'member')))
      );
    }

    // An invitation to a group, named "<groupId>_<toUid>". Only members of the group can send one,
    // in their own name. Both the sender and the invited person can see it, and either can delete
    // it (the invited person does when joining or declining). Accepting is just joining the group.
    match /groupInvites/{inviteId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && inviteId == request.resource.data.groupId + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && inMyGroup(request.resource.data.groupId);
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // A request is one document, named "<fromUid>_<toUid>".
    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.to;
      allow read: if signedIn() && resource.data.from == request.auth.uid;
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // A friendship can only be created by the person who received the request, and
    // either friend can remove it.
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/friendRequests/$(
             (request.resource.data.members[0] == request.auth.uid
               ? request.resource.data.members[1] : request.resource.data.members[0]) + '_' + request.auth.uid));
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Direct messages. One conversation per pair of friends, named like their friendship ("<uidA>_<uidB>", ids sorted).
    // Only the two people can read it, and only while they are friends can either write to it. Messages cannot be
    // edited or deleted. "seen" holds when each person last read the conversation, and you can only change your own.
    function inPair(pid) { return signedIn() && request.auth.uid in pid.split('_'); }
    function friendsInPair(pid) { return exists(/databases/$(database)/documents/friendships/$(pid)); }

    match /conversations/{pid} {
      // Judged on the document's own members (not its name) so the inbox query (members array-contains you) is allowed.
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if inPair(pid)
        && friendsInPair(pid)
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastFrom', 'updatedAt', 'seen'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 120
        && request.resource.data.updatedAt == request.time
        && request.resource.data.seen.keys().hasOnly([request.auth.uid]);
      allow update: if inPair(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastFrom', 'updatedAt', 'seen'])
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly([request.auth.uid])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastFrom', 'updatedAt'])
            || (friendsInPair(pid)
                && request.resource.data.lastFrom == request.auth.uid
                && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 120
                && request.resource.data.updatedAt == request.time));

      match /messages/{messageId} {
        allow read: if inPair(pid);
        allow create: if inPair(pid)
          && friendsInPair(pid)
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'image', 'gif'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          // a message needs some text, a picture or a GIF
          && (request.resource.data.text.size() > 0 || 'image' in request.resource.data || 'gif' in request.resource.data)
          // a picture is a small JPEG data URL (keep the size in step with IMAGE_MAX_CHARS in src/messages.ts)
          && (!('image' in request.resource.data)
              || (request.resource.data.image is string
                  && request.resource.data.image.size() > 11
                  && request.resource.data.image.size() <= 300000
                  && request.resource.data.image[0:11] == 'data:image/'))
          // GIFs may only be loaded from Giphy or Tenor over https (keep in step with src/stickers.ts)
          && (!('gif' in request.resource.data)
              || (request.resource.data.gif is string
                  && request.resource.data.gif.size() <= 300
                  && request.resource.data.gif.matches('^https://(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com)/.*')))
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
