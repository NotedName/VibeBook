# Copy this file to .env and fill in your Firebase web app settings (Firebase console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA v3 site key for Firebase App Check (see SECURITY.md)
VITE_APPCHECK_SITE_KEY=
