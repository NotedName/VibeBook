rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone must be signed in with a verified email address.
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Friendships are stored once per pair under the two ids sorted and joined with "_".
    function isFriend(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a));
    }

    // Audiences: who can see a profile detail (friends list, hours, schedule). Profiles saved before audiences existed
    // hold friendsVisible / hoursVisible booleans, which map to the same reach.
    //  - private: only the owner;  friends: the owner's friends;  everyone: anyone signed in;
    //  - fof (friends of friends): the owner's friends, and people with a pointer at users/{me}/reach/{owner} whose
    //    "via" is a friend of both. The pointer is checked against the live friendships on every read, so unfriending
    //    ends the access without anything to clean up (see reachOk, and the reach rule below).
    function profileOf(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
    function friendsAudience(p) { return p.get('friendsAudience', p.get('friendsVisible', true) == false ? 'private' : 'everyone'); }
    function hoursAudience(p) { return p.get('hoursAudience', p.get('hoursVisible', false) == true ? 'everyone' : 'private'); }
    function scheduleAudience(p) { return p.get('scheduleAudience', 'private'); }
    function statusAudience(p) { return p.get('statusAudience', 'private'); }
    function reachOk(owner) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/reach/$(owner);
      return exists(path)
        && isFriend(request.auth.uid, get(path).data.via)
        && isFriend(get(path).data.via, owner);
    }
    // Private profile (Settings > Privacy, "privateProfile"): only friends see the owner's entries, hours, schedule,
    // friends list, reposts and private-group teasers. Everyone else still sees the profile document itself.
    function profileLocked(uid) {
      let path = /databases/$(database)/documents/profiles/$(uid);
      return exists(path) && get(path).data.get('privateProfile', false) == true;
    }
    // A deactivated account (Profile > Deactivate account) shows nothing to anyone else, friends included.
    function profileDeactivated(uid) {
      let path = /databases/$(database)/documents/profiles/$(uid);
      return exists(path) && get(path).data.get('deactivated', false) == true;
    }
    function mayOpen(uid) { return !profileDeactivated(uid) && (isFriend(request.auth.uid, uid) || !profileLocked(uid)); }
    function canSee(owner, audience) {
      return isOwner(owner) || (signedIn() && (
        (audience == 'everyone' && mayOpen(owner))
        || (audience == 'friends' && isFriend(request.auth.uid, owner) && !profileDeactivated(owner))
        || (audience == 'fof' && !profileDeactivated(owner) && (isFriend(request.auth.uid, owner) || (!profileLocked(owner) && reachOk(owner))))));
    }

    // Membership is one document per person and group, named "<groupId>_<uid>".
    function inMyGroup(gid) {
      return exists(/databases/$(database)/documents/groupMembers/$(gid + '_' + request.auth.uid));
    }

    // Roles in a group live on the member's document ("admin", "moderator" or "member"; none counts
    // as member). The group's owner is always an admin, even on documents from before roles existed.
    function groupOwner(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data.ownerUid; }
    function roleIn(gid, uid) {
      return exists(/databases/$(database)/documents/groupMembers/$(gid + '_' + uid))
        ? get(/databases/$(database)/documents/groupMembers/$(gid + '_' + uid)).data.get('role', 'member')
        : '';
    }
    function isAdminOf(gid) { return signedIn() && (groupOwner(gid) == request.auth.uid || roleIn(gid, request.auth.uid) == 'admin'); }
    function isModOf(gid) { return signedIn() && roleIn(gid, request.auth.uid) == 'moderator'; }

    // An entry lists the groups it is shared to in groupIds. Rules cannot loop, so only the
    // first five are checked (the app never saves more than five).
    function sharedWithMyGroup(entry) {
      let g = entry.get('groupIds', []);
      return (g.size() > 0 && inMyGroup(g[0]))
        || (g.size() > 1 && inMyGroup(g[1]))
        || (g.size() > 2 && inMyGroup(g[2]))
        || (g.size() > 3 && inMyGroup(g[3]))
        || (g.size() > 4 && inMyGroup(g[4]));
    }

    // For photos and comments, which hang off an entry: can the signed-in person see the entry?
    function entryReadable(uid, entryId) {
      let e = get(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)).data;
      return (e.get('visibility', 'private') == 'public' && mayOpen(uid))
        || (e.get('visibility', 'private') == 'friends' && isFriend(request.auth.uid, uid))
        || sharedWithMyGroup(e);
    }

    // Public entries can be opened without signing in, but only by someone who already has the
    // entry's link (unguessable id). Signed-out visitors get "get" on one entry, and read on its
    // photos, comments and reactions. They cannot list entries, so nothing can be browsed, and
    // they cannot write anything.
    function entryIsPublic(uid, entryId) {
      return get(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)).data.get('visibility', 'private') == 'public'
        && !profileLocked(uid);
    }

    // A repost puts someone else's public entry in your own logbook (and optionally in groups you
    // are in). It is a pointer, named "<ownerUid>_<entryId>"; the entry stays where it is. Anyone
    // signed in can read the pointers (the entry itself is still checked by its own rules), only
    // you can write yours, and only public entries of other people can be reposted.
    match /users/{uid}/reposts/{repostId} {
      allow read: if signedIn() && (isOwner(uid) || mayOpen(uid));
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'entryId', 'date', 'time', 'groupIds', 'createdAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.entryId is string
        && request.resource.data.ownerUid != uid
        && repostId == request.resource.data.ownerUid + '_' + request.resource.data.entryId
        && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 5
        && request.resource.data.createdAt == request.time
        && entryIsPublic(request.resource.data.ownerUid, request.resource.data.entryId);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds'])
        && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 5;
      allow delete: if isOwner(uid);
    }

    // Teasers: a tiny note that one of your entries was posted to a PRIVATE group, so your profile can say
    // "join the group to see this post" instead of showing it. It holds only the entry id, the date and the
    // private group ids, never the entry's text or photos. Any signed-in person can read them; only you write them.
    match /users/{uid}/teasers/{entryId} {
      allow read: if signedIn() && (isOwner(uid) || mayOpen(uid));
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['entryId', 'groupIds', 'date', 'time'])
        && request.resource.data.entryId == entryId
        && request.resource.data.groupIds is list
        && request.resource.data.groupIds.size() <= 5
        && request.resource.data.date is string
        && request.resource.data.time is string;
      allow delete: if isOwner(uid);
    }

    // Your Likes list: a private pointer, named "<ownerUid>_<entryId>", to every entry you gave a Vibing.
    // Only you can read or write it, and only for entries you can see.
    match /users/{uid}/likes/{likeId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'entryId', 'createdAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.entryId is string
        && likeId == request.resource.data.ownerUid + '_' + request.resource.data.entryId
        && request.resource.data.createdAt == request.time
        && (request.resource.data.ownerUid == uid
            || entryReadable(request.resource.data.ownerUid, request.resource.data.entryId));
      allow delete: if isOwner(uid);
    }

    // Friends list others can open: one pointer per friend at users/{uid}/friendList/{friendUid}. Each person
    // keeps their own list in step with their real friendships (the app does it), and a pointer can only be
    // written for someone you are friends with. People in the owner's friendsAudience can read it
    // (Settings > Privacy); the owner always can. A friend can remove
    // themselves from your list, so unfriending cannot leave a stale entry behind.
    match /users/{uid}/friendList/{friendId} {
      allow read: if canSee(uid, friendsAudience(profileOf(uid)));
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && isFriend(uid, friendId);
      allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == friendId);
    }

    // Friends-of-friends pointer: users/{me}/reach/{owner} = { via }, written by me to say "{owner} is a friend of my friend
    // {via}". It only exists to be checked by reachOk above, so it can be created or overwritten only while both
    // friendships are real, and nobody but me can read it.
    match /users/{uid}/reach/{ownerId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['via'])
        && request.resource.data.via is string
        && isFriend(uid, request.resource.data.via)
        && isFriend(request.resource.data.via, ownerId);
    }

    // Notifications for {uid}: requests, likes, comments, reposts and the like. The person who did the
    // thing writes it (so it is created by someone else, as themselves), and its id starts with their
    // uid so nobody can overwrite another person's. The recipient reads them, marks them read and
    // deletes them; the writer can take theirs back (an undone like or a cancelled request).
    match /users/{uid}/notifications/{noteId} {
      allow read: if isOwner(uid);
      allow create: if signedIn()
        && request.auth.uid != uid
        && noteId.matches('^' + request.auth.uid + '_.{1,300}$')
        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'ownerUid', 'entryId', 'photoId', 'title', 'groupId', 'groupName', 'createdAt', 'read'])
        && request.resource.data.type in ['friend_request', 'friend_accept', 'follow', 'group_invite', 'group_request', 'group_approved', 'group_deleted', 'like', 'comment', 'reply', 'comment_like', 'repost']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('title', '').size() <= 140
        && request.resource.data.get('groupName', '').size() <= 60
        && request.resource.data.get('ownerUid', '').size() <= 128
        && request.resource.data.get('entryId', '').size() <= 128
        && request.resource.data.get('photoId', '').size() <= 128
        && request.resource.data.get('groupId', '').size() <= 128;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(uid) || (signedIn() && resource.data.actorUid == request.auth.uid);
    }

    // Activity log: one small document per action you take, at users/{uid}/activity/{id}, so the log follows you to every
    // device. Only you can read it. It is append-only: nothing can be changed or deleted, and re-saving an item that is
    // already there with the same content is allowed so a device can safely upload its older log again.
    match /users/{uid}/activity/{itemId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && itemId.size() <= 60
        && request.resource.data.keys().hasAll(['at', 'text'])
        && request.resource.data.keys().hasOnly(['at', 'text', 'who', 'href'])
        && request.resource.data.at is number
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.get('who', '') is string
        && request.resource.data.get('who', '').size() <= 128
        && request.resource.data.get('href', '') is string
        && request.resource.data.get('href', '').size() <= 200;
      allow update: if isOwner(uid) && request.resource.data == resource.data;
      allow delete: if false;
    }

    // Hours: private documents that follow you to every device. Only you can read or write them, except 'shared'.
    //  - goal:   { requiredHours, workDays, daysOff, daysOn, hoursPerDay, startTime, endTime, breakMinutes }: the hours your school or company requires
    //            (1 to 10000, may have decimals; absent when no goal is set) and which days you can work. workDays are
    //            weekday numbers 0 to 6; daysOff and daysOn are dates that differ from the usual week (no limit);
    //  - clock:  { date, time, edited, origDate, origTime, breakMs, breakStart, breakPlanned, planUsed }: the moment you clocked in (and, if you changed it, when you really did), present only while the clock is running. breakMs is the break time taken so far; breakStart (epoch ms) is present only while a break is running;
    //  - report: the lines printed at the top of exported Word and PDF reports (names, school), each up to 120 characters;
    //  - shared: { minutes, requiredMinutes }: the total you have logged and the total required, which the people in your
    //            hoursAudience can read (Settings > Privacy). The app keeps it in step and deletes it when you choose only me;
    //  - schedule: { workDays, hoursPerDay, daysOff, daysOn, startTime, endTime, breakMinutes }: your usual week and the single dates that differ from it, which the people in your scheduleAudience can read. The app keeps
    //            it in step and deletes it when you choose only me.
    // The hours worked are on the entries themselves (clockIn, clockOut, minutes).
    match /users/{uid}/hours/{docId} {
      allow read: if isOwner(uid)
        || (docId == 'shared' && canSee(uid, hoursAudience(profileOf(uid))))
        || (docId == 'schedule' && canSee(uid, scheduleAudience(profileOf(uid))))
        || (docId == 'status' && canSee(uid, statusAudience(profileOf(uid))));
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && (
        (docId == 'goal'
          && request.resource.data.keys().hasOnly(['requiredHours', 'workDays', 'daysOff', 'daysOn', 'holidays', 'hoursPerDay', 'startDate', 'startTime', 'endTime', 'breakMinutes', 'breakAt'])
          && request.resource.data.get('startDate', '') is string && request.resource.data.get('startDate', '').size() <= 10
          && request.resource.data.get('holidays', []) is list && request.resource.data.get('holidays', []).size() <= 200
          && request.resource.data.get('breakAt', '00:00') is string && request.resource.data.get('breakAt', '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.get('requiredHours', 1) is number
          && request.resource.data.get('requiredHours', 1) > 0
          && request.resource.data.get('requiredHours', 1) <= 10000
          && request.resource.data.get('workDays', []) is list && request.resource.data.get('workDays', []).size() <= 7
          && request.resource.data.get('daysOff', []) is list
          && request.resource.data.get('daysOn', []) is list
          && request.resource.data.get('hoursPerDay', 8) is number
          && request.resource.data.get('hoursPerDay', 8) > 0
          && request.resource.data.get('hoursPerDay', 8) <= 24
          && request.resource.data.get('startTime', '00:00') is string
          && request.resource.data.get('startTime', '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.get('endTime', '00:00') is string
          && request.resource.data.get('endTime', '00:00').matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.get('breakMinutes', 0) is number
          && request.resource.data.get('breakMinutes', 0) >= 0 && request.resource.data.get('breakMinutes', 0) <= 1440)
        || (docId == 'clock'
          && request.resource.data.keys().hasOnly(['date', 'time', 'edited', 'origDate', 'origTime', 'breakMs', 'breakStart', 'breakPlanned', 'planUsed'])
          && request.resource.data.get('breakPlanned', false) is bool
          && request.resource.data.get('planUsed', false) is bool
          && request.resource.data.get('breakMs', 0) is number && request.resource.data.get('breakMs', 0) >= 0
          && request.resource.data.get('breakStart', 0) is number
          && request.resource.data.get('edited', false) is bool
          && request.resource.data.get('origDate', '0000-00-00') is string && request.resource.data.get('origDate', '0000-00-00').size() == 10
          && request.resource.data.get('origTime', '00:00') is string && request.resource.data.get('origTime', '00:00').size() == 5
          && request.resource.data.date is string && request.resource.data.date.size() == 10
          && request.resource.data.time is string && request.resource.data.time.size() == 5)
        || (docId == 'report'
          && request.resource.data.keys().hasOnly(['traineeName', 'course', 'term', 'school', 'department', 'program', 'schoolYear', 'location', 'company', 'deployed', 'supervisor'])
          && request.resource.data.get('location', '') is string && request.resource.data.get('location', '').size() <= 120
          && request.resource.data.get('company', '') is string && request.resource.data.get('company', '').size() <= 120
          && request.resource.data.get('deployed', '') is string && request.resource.data.get('deployed', '').size() <= 120
          && request.resource.data.get('supervisor', '') is string && request.resource.data.get('supervisor', '').size() <= 120
          && request.resource.data.get('traineeName', '') is string && request.resource.data.get('traineeName', '').size() <= 120
          && request.resource.data.get('course', '') is string && request.resource.data.get('course', '').size() <= 120
          && request.resource.data.get('term', '') is string && request.resource.data.get('term', '').size() <= 120
          && request.resource.data.get('school', '') is string && request.resource.data.get('school', '').size() <= 120
          && request.resource.data.get('department', '') is string && request.resource.data.get('department', '').size() <= 120
          && request.resource.data.get('program', '') is string && request.resource.data.get('program', '').size() <= 120
          && request.resource.data.get('schoolYear', '') is string && request.resource.data.get('schoolYear', '').size() <= 120)
        || (docId == 'shared'
          && request.resource.data.keys().hasOnly(['minutes', 'requiredMinutes'])
          && request.resource.data.minutes is number
          && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 1000000
          && request.resource.data.get('requiredMinutes', 1) is number
          && request.resource.data.get('requiredMinutes', 1) > 0
          && request.resource.data.get('requiredMinutes', 1) <= 600000)
        || (docId == 'status'
          && request.resource.data.keys().hasOnly(['since', 'onBreak', 'breakEndsAt'])
          && request.resource.data.since is number
          && request.resource.data.onBreak is bool
          && request.resource.data.get('breakEndsAt', 0) is number)
        || (docId == 'schedule'
          && request.resource.data.keys().hasOnly(['workDays', 'hoursPerDay', 'daysOff', 'daysOn', 'startDate', 'startTime', 'endTime', 'breakMinutes', 'breakAt'])
          && request.resource.data.get('breakAt', '00:00') is string && request.resource.data.get('breakAt', '00:00').size() == 5
          && request.resource.data.get('daysOff', []) is list
          && request.resource.data.get('daysOn', []) is list
          && request.resource.data.get('startTime', '00:00') is string && request.resource.data.get('startTime', '00:00').size() == 5
          && request.resource.data.get('endTime', '00:00') is string && request.resource.data.get('endTime', '00:00').size() == 5
          && request.resource.data.get('breakMinutes', 0) is number
          && request.resource.data.workDays is list && request.resource.data.workDays.size() <= 7
          && request.resource.data.hoursPerDay is number
          && request.resource.data.hoursPerDay > 0 && request.resource.data.hoursPerDay <= 24)
      );
    }

    match /users/{uid}/following/{targetId} {
      allow read, write: if isOwner(uid);
    }

    // Friends you unfollowed: still friends, but not in your Following feed. Only you can see or change it.
    match /users/{uid}/unfollowed/{targetId} {
      allow read, write: if isOwner(uid);
    }

    // Other people can read an entry only when its owner shared it with them: publicly, with
    // friends, or with a group they are in. Entries with no visibility field are private.
    // Text limits for an entry: activity 140, description 2000, at most 15 skills. An edit that does not touch the
    // text (sharing to a group, say) is never blocked, so entries written before the limits stay editable.
    function entryTextOk(d) {
      return d.get('title', '').size() <= 140
        && d.get('description', '').size() <= 2000
        && d.get('skills', []).size() <= 15;
    }

    // "discoverable" puts an entry in other people's "For you" feed (see the collection group rule below). The app
    // sets it only on public entries of a public profile; here it can never be set on an entry that is not public.
    function discoverOk(d) {
      return d.get('discoverable', false) != true || d.get('visibility', 'private') == 'public';
    }

    // The "For you" feed: a collection group query over every person's entries, limited to the ones marked discoverable
    // (public entries of public profiles). The query has to include where('discoverable', '==', true) and a limit of 100
    // or less. Nothing else can be listed this way.
    match /{path=**}/entries/{entryId} {
      allow list: if signedIn() && resource.data.discoverable == true && request.query.limit <= 100;
    }

    // An entry's GIF is a link to Giphy or Tenor over https, the same hosts as in messages and comments (keep in step with src/stickers.ts).
    function entryGifOk(d) {
      return d.get('gif', '') is string
        && d.get('gif', '').size() <= 300
        && (d.get('gif', '') == ''
            || d.get('gif', '').matches('^https://(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com)/.*'));
    }

    // Rate limit. "rate/{uid}" holds when a person last created an entry. The app writes it in the same batch as the entry
    // (addEntry in src/entries.ts), and a new entry is refused unless that write is in the batch: getAfter reads the document as
    // it will be once the batch lands. The rate document itself refuses a stamp less than 5 seconds after the last one, and a
    // refused write fails the whole batch. Only the owner can write it, nobody can read or delete it.
    match /rate/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['entryAt'])
        && request.resource.data.entryAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['entryAt'])
        && request.resource.data.entryAt == request.time
        && resource.data.entryAt + duration.value(5, 's') <= request.time;
    }

    // One-time evaluation forms. The id is random, so only whoever was given the link can open it. The details of the form are stored (the
    // trainee's name, course and dates); the evaluator's ratings and comments are never sent to the database. Once the evaluator has made
    // the file the status becomes "done" and the link closes. There is no way to list evaluations.
    match /evaluations/{evalId} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['ownerUid', 'status', 'createdAt', 'payload'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time && request.resource.data.payload is map;
      allow update: if resource.data.status == 'open' && request.resource.data.status == 'done'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneAt'])
        && request.resource.data.doneAt == request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Push notification tokens of this person's devices. Only the owner can read, add or remove them; the push function reads them with admin rights.
    match /users/{uid}/pushTokens/{token} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['createdAt', 'agent']) && request.resource.data.createdAt == request.time
        && (!('agent' in request.resource.data) || (request.resource.data.agent is string && request.resource.data.agent.size() <= 200));
    }

    match /users/{uid}/entries/{entryId} {
      allow read, delete: if isOwner(uid);
      // createdAt is the real time of posting, set by the server. The "date and time" fields are the time the entry is about, which the owner may change.
      allow create: if isOwner(uid) && entryTextOk(request.resource.data) && entryGifOk(request.resource.data) && discoverOk(request.resource.data)
        && request.resource.data.get('createdAt', request.time) == request.time
        && getAfter(/databases/$(database)/documents/rate/$(uid)).data.entryAt == request.time;
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'skills'])
            || entryTextOk(request.resource.data))
        && entryGifOk(request.resource.data)
        && discoverOk(request.resource.data);
      allow get: if resource.data.get('visibility', 'private') == 'public' && !profileLocked(uid);
      allow read: if signedIn() && (
        (resource.data.visibility == 'public' && mayOpen(uid)) ||
        (resource.data.visibility == 'friends' && isFriend(request.auth.uid, uid)) ||
        sharedWithMyGroup(resource.data)
      );

      match /photos/{photoId} {
        allow read, write: if isOwner(uid);
        allow read: if signedIn() && entryReadable(uid, entryId);
        allow read: if entryIsPublic(uid, entryId);

        // Each photo has its own reactions and comments, with the same rules as the entry's: whoever can
        // see the entry can react, comment and reply, and the photo has to exist. Photos are removed
        // with their entry by the app, so those documents go with them.
        // Anyone who can read the entry can comment and reply (parentId is "" or an existing comment)
        // and like. A comment can be deleted by its author or by the owner of the entry. Text cannot
        // be edited; the only updates are a like or unlike of your own, or blanking a comment that
        // has replies to "[deleted]". A comment can carry a sticker or GIF instead of, or as well as, text.
        match /comments/{commentId} {
          // After an update, the likes list differs from before by at most the signed-in person's own uid.
          function onlyMyLikeChanged() {
            let before = resource.data.get('likes', []).toSet();
            let after = request.resource.data.likes.toSet();
            return request.resource.data.likes is list
              && request.resource.data.likes.size() == after.size()
              && after.difference(before).hasOnly([request.auth.uid])
              && before.difference(after).hasOnly([request.auth.uid]);
          }

          allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
          allow read: if entryIsPublic(uid, entryId);
          allow create: if signedIn()
            && request.resource.data.keys().hasOnly(['authorUid', 'text', 'sticker', 'gif', 'createdAt', 'parentId', 'likes'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.parentId is string
            && request.resource.data.parentId.size() <= 40
            && (request.resource.data.parentId == ''
                || exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/photos/$(photoId)/comments/$(request.resource.data.parentId)))
            && request.resource.data.likes == []
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 500
            && request.resource.data.sticker is string
            && request.resource.data.sticker.size() <= 16
            && request.resource.data.gif is string
            && request.resource.data.gif.size() <= 300
            // GIFs may only be loaded from Giphy or Tenor over https (keep in step with src/stickers.ts).
            && (request.resource.data.gif == ''
                || request.resource.data.gif.matches('^https://(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com)/.*'))
            // a comment needs some text, a sticker or a GIF
            && (request.resource.data.text.size() > 0
                || request.resource.data.sticker.size() > 0
                || request.resource.data.gif.size() > 0)
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/photos/$(photoId))
            && (request.auth.uid == uid || entryReadable(uid, entryId));
          allow update: if signedIn() && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && (request.auth.uid == uid || entryReadable(uid, entryId))
              && onlyMyLikeChanged())
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'sticker', 'gif', 'deleted'])
              && request.resource.data.text == ''
              && request.resource.data.get('sticker', '') == ''
              && request.resource.data.get('gif', '') == ''
              && request.resource.data.deleted == true
              && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid))
          );
          allow delete: if signedIn() && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid);
        }

        // One document per person, named by their uid, so nobody can react twice. "vibing" or
        // "notvibing". Anyone who can see the entry can react; you can only touch your own reaction,
        // and the entry's owner can remove any.
        match /reactions/{reactorId} {
          allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
          allow read: if entryIsPublic(uid, entryId);
          allow create, update: if signedIn()
            && request.auth.uid == reactorId
            && request.resource.data.keys().hasOnly(['type', 'createdAt'])
            && request.resource.data.type in ['vibing', 'notvibing']
            && request.resource.data.createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/photos/$(photoId))
            && (request.auth.uid == uid || entryReadable(uid, entryId));
          allow delete: if signedIn() && (request.auth.uid == reactorId || request.auth.uid == uid);
        }
      }

      // Anyone who can read the entry can comment and reply (parentId is "" or an existing comment)
      // and like. A comment can be deleted by its author or by the owner of the entry. Text cannot
      // be edited; the only updates are a like or unlike of your own, or blanking a comment that
      // has replies to "[deleted]". A comment can carry a sticker or GIF instead of, or as well as, text.
      match /comments/{commentId} {
        // After an update, the likes list differs from before by at most the signed-in person's own uid.
        function onlyMyLikeChanged() {
          let before = resource.data.get('likes', []).toSet();
          let after = request.resource.data.likes.toSet();
          return request.resource.data.likes is list
            && request.resource.data.likes.size() == after.size()
            && after.difference(before).hasOnly([request.auth.uid])
            && before.difference(after).hasOnly([request.auth.uid]);
        }

        allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
        allow read: if entryIsPublic(uid, entryId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'text', 'sticker', 'gif', 'createdAt', 'parentId', 'likes'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.parentId is string
          && request.resource.data.parentId.size() <= 40
          && (request.resource.data.parentId == ''
              || exists(/databases/$(database)/documents/users/$(uid)/entries/$(entryId)/comments/$(request.resource.data.parentId)))
          && request.resource.data.likes == []
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.sticker is string
          && request.resource.data.sticker.size() <= 16
          && request.resource.data.gif is string
          && request.resource.data.gif.size() <= 300
          // GIFs may only be loaded from Giphy or Tenor over https (keep in step with src/stickers.ts).
          && (request.resource.data.gif == ''
              || request.resource.data.gif.matches('^https://(media[0-9]*\\.giphy\\.com|i\\.giphy\\.com|media[0-9]*\\.tenor\\.com|c\\.tenor\\.com)/.*'))
          // a comment needs some text, a sticker or a GIF
          && (request.resource.data.text.size() > 0
              || request.resource.data.sticker.size() > 0
              || request.resource.data.gif.size() > 0)
          && request.resource.data.createdAt == request.time
          && (request.auth.uid == uid || entryReadable(uid, entryId));
        allow update: if signedIn() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && (request.auth.uid == uid || entryReadable(uid, entryId))
            && onlyMyLikeChanged())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'sticker', 'gif', 'deleted'])
            && request.resource.data.text == ''
            && request.resource.data.get('sticker', '') == ''
            && request.resource.data.get('gif', '') == ''
            && request.resource.data.deleted == true
            && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid))
        );
        allow delete: if signedIn() && (request.auth.uid == uid || resource.data.authorUid == request.auth.uid);
      }

      // One document per person, named by their uid, so nobody can react twice. "vibing" or
      // "notvibing". Anyone who can see the entry can react; you can only touch your own reaction,
      // and the entry's owner can remove any.
      match /reactions/{reactorId} {
        allow read: if isOwner(uid) || (signedIn() && entryReadable(uid, entryId));
        allow read: if entryIsPublic(uid, entryId);
        allow create, update: if signedIn()
          && request.auth.uid == reactorId
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['vibing', 'notvibing']
          && request.resource.data.createdAt == request.time
          && (request.auth.uid == uid || entryReadable(uid, entryId));
        allow delete: if signedIn() && (request.auth.uid == reactorId || request.auth.uid == uid);
      }
    }

    // Usernames. One document per name, and the document id IS the name (lowercase letters, numbers and
    // underscores, 3 to 20 long), so a name can only ever belong to one person. It can be created only
    // while nobody holds it (a create on an existing document counts as an update, which is not allowed),
    // and only released by the person it belongs to.
    //  - get: anyone, even signed out, so the sign-up form can say "taken" and profile links can find the person.
    //  - list: only your own, which is how profile setup finds the name you picked at sign-up.
    //  - create: verified accounts only, so unconfirmed or throwaway sign-ups can never hold a name.
    match /usernames/{name} {
      allow get: if true;
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // A profile's username must be one it owns. getAfter() sees the usernames document written in the same
    // transaction. Profiles from before usernames existed keep an empty one until their owner picks a name.
    function usernameOk(uid) {
      let d = request.resource.data;
      return d.username is string && (
        (d.username.matches('^[a-z0-9_]{3,20}$')
          && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == uid)
        || (d.username == '' && resource != null && resource.data.get('username', '') == '')
      );
    }

    // Public profile cards. Any signed-in person can read them (that is how search works);
    // only the owner can write theirs. The email address is never stored here.
    match /profiles/{uid} {
      allow read: if signedIn();
      // Lets a share link show the author's name and photo to signed-out visitors. Only a single
      // profile can be fetched by id; searching and listing still need an account.
      allow get: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && usernameOk(uid)
        && request.resource.data.bio.size() <= 300
        && request.resource.data.avatar.size() <= 120000
        && request.resource.data.coverPhoto.size() <= 120000
        && request.resource.data.get('friendsAudience', 'everyone') in ['private', 'friends', 'fof', 'everyone']
        && request.resource.data.get('hoursAudience', 'private') in ['private', 'friends', 'fof', 'everyone']
        && request.resource.data.get('scheduleAudience', 'private') in ['private', 'friends', 'fof', 'everyone']
        && request.resource.data.get('statusAudience', 'private') in ['private', 'friends', 'fof', 'everyone']
        && request.resource.data.get('privateProfile', false) is bool
        && request.resource.data.get('activeStatus', true) is bool
        && request.resource.data.get('deactivated', false) is bool
        && (!('deactivatedAt' in request.resource.data) || request.resource.data.deactivatedAt is timestamp);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Any signed-in person can find a group and open its page. Public groups (privacy missing or "public")
    // can be joined by anyone; private groups need an invitation or an approved request (see groupMembers).
    // Up to five questions can be asked of people requesting to join a private group.
    function privacyOk(d) {
      return d.get('privacy', 'public') in ['public', 'private']
        && d.get('questions', []) is list
        && d.get('questions', []).size() <= 5;
    }
    function groupIsOpen(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data.get('privacy', 'public') == 'public'; }

    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && privacyOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.get('avatar', '').size() <= 120000
        && request.resource.data.get('coverPhoto', '').size() <= 120000;

      // Only an admin can edit the group's name, description and photos. The owner never changes.
      allow update: if isAdminOf(gid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameKeys', 'description', 'avatar', 'coverPhoto', 'cover', 'privacy', 'questions'])
        && request.resource.data.get('cover', 'amethyst') in ['amethyst', 'dusk', 'steel']
        && privacyOk(request.resource.data)
        && request.resource.data.get('avatar', '').size() <= 120000
        && request.resource.data.get('coverPhoto', '').size() <= 120000
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300;

      // Only the owner can delete the group. The app first notifies the members, then removes memberships, invites,
      // requests, bans and feed posts, and deletes this document last.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Requests to join a private group, named by the requester's uid. Only that person can send one (in their own
      // name, to a private group, with a "why" message of 1 to 300 characters and one answer per question), and only
      // they and the group's admins and moderators can read or delete it. Approving is an admin or moderator creating
      // the membership (see groupMembers) and deleting the request.
      match /requests/{requestUid} {
        allow read: if isAdminOf(gid) || isModOf(gid) || (signedIn() && request.auth.uid == requestUid);
        allow create: if signedIn()
          && request.auth.uid == requestUid
          && request.resource.data.keys().hasOnly(['message', 'answers', 'createdAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 300
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 5
          && request.resource.data.createdAt == request.time
          && !groupIsOpen(gid)
          && !inMyGroup(gid)
          && !exists(/databases/$(database)/documents/groups/$(gid)/bans/$(request.auth.uid));
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == requestUid || isAdminOf(gid) || isModOf(gid));
      }

      // People removed from the group, named by their uid. They cannot join again until an admin
      // deletes this. Admins can bar anyone but the owner; moderators only current plain members.
      match /bans/{bannedUid} {
        allow read: if isAdminOf(gid) || isModOf(gid) || (signedIn() && request.auth.uid == bannedUid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['by', 'createdAt'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.createdAt == request.time
          && bannedUid != groupOwner(gid)
          && bannedUid != request.auth.uid
          && (isAdminOf(gid) || (isModOf(gid) && roleIn(gid, bannedUid) == 'member'));
        allow delete: if isAdminOf(gid);
      }

      // Lists an entry in the group's feed. Only members can add to it, in one of two ways:
      //  - their own entry, named "<ownerUid>_<entryId>";
      //  - a repost of someone else's public entry, named "<me>_rp_<ownerUid>_<entryId>", with
      //    repostedBy set to themselves.
      // Whoever added a post can always take it out again, and so can the group's admins and moderators.
      match /posts/{postId} {
        allow read: if signedIn() && inMyGroup(gid);
        allow create, update: if signedIn() && inMyGroup(gid)
          && (
            (request.resource.data.get('repostedBy', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
              && postId == request.auth.uid + '_' + request.resource.data.entryId)
            || (request.resource.data.get('repostedBy', '') == request.auth.uid
              && request.resource.data.keys().hasOnly(['ownerUid', 'entryId', 'date', 'time', 'repostedBy'])
              && request.resource.data.ownerUid is string
              && request.resource.data.ownerUid != request.auth.uid
              && postId == request.auth.uid + '_rp_' + request.resource.data.ownerUid + '_' + request.resource.data.entryId
              // an entry is in a group once: no repost into a group that already has the original post
              && !exists(/databases/$(database)/documents/groups/$(gid)/posts/$(request.resource.data.ownerUid + '_' + request.resource.data.entryId))
              && entryIsPublic(request.resource.data.ownerUid, request.resource.data.entryId))
          );
        allow delete: if signedIn()
          && (resource.data.ownerUid == request.auth.uid || resource.data.get('repostedBy', '') == request.auth.uid
              || isAdminOf(gid) || isModOf(gid));
      }
    }

    // Joining, in three ways:
    //  - for yourself, into a public group, or into a private group you were invited to (as a member, unless barred);
    //  - an admin or moderator letting in someone who asked to join a private group (their request must exist);
    //  - the group's owner creating it, together with the group, as its first member and admin.
    // Anyone can leave for themselves, except the group's owner, who stays. Joining requires the group to exist after
    // the write, so creating a group and its first member can be one batch.
    // Admins change roles (never the owner's, never their own). Admins remove anyone but the
    // owner, and moderators remove plain members.
    match /groupMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'uid', 'joinedAt', 'role'])
        && request.resource.data.uid is string
        && memberId == request.resource.data.groupId + '_' + request.resource.data.uid
        && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/bans/$(request.resource.data.uid))
        && (
          (request.resource.data.uid == request.auth.uid
            && request.resource.data.get('role', 'member') == 'member'
            && (groupIsOpen(request.resource.data.groupId)
                || exists(/databases/$(database)/documents/groupInvites/$(request.resource.data.groupId + '_' + request.auth.uid))))
          || (request.resource.data.uid == request.auth.uid
              && request.resource.data.get('role', 'member') == 'admin'
              && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid)
          || (request.resource.data.uid != request.auth.uid
              && request.resource.data.get('role', 'member') == 'member'
              && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/requests/$(request.resource.data.uid))
              && (isAdminOf(request.resource.data.groupId) || isModOf(request.resource.data.groupId)))
        );
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['admin', 'moderator', 'member']
        && resource.data.uid != groupOwner(resource.data.groupId)
        && resource.data.uid != request.auth.uid
        && isAdminOf(resource.data.groupId);
      allow delete: if signedIn() && (
        groupOwner(resource.data.groupId) == request.auth.uid
        || (resource.data.uid == request.auth.uid && groupOwner(resource.data.groupId) != request.auth.uid)
        || (resource.data.uid != groupOwner(resource.data.groupId)
            && resource.data.uid != request.auth.uid
            && (isAdminOf(resource.data.groupId)
                || (isModOf(resource.data.groupId) && resource.data.get('role', 'member') == 'member')))
      );
    }

    // An invitation to a group, named "<groupId>_<toUid>". Only members of the group can send one,
    // in their own name. Both the sender and the invited person can see it, and either can delete
    // it (the invited person does when joining or declining). Accepting is just joining the group.
    match /groupInvites/{inviteId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && inviteId == request.resource.data.groupId + '_' + request.resource.data.to
        && request.resource.data.createdAt == request.time
        && inMyGroup(request.resource.data.groupId);
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdminOf(resource.data.groupId));
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || groupOwner(resource.data.groupId) == request.auth.uid);
    }

    // A request is one document, named "<fromUid>_<toUid>".
    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.to;
      allow read: if signedIn() && resource.data.from == request.auth.uid;
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // A friendship can only be created by the person who received the request, and
    // either friend can remove it.
    match /friendships/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/friendRequests/$(
             (request.resource.data.members[0] == request.auth.uid
               ? request.resource.data.members[1] : request.resource.data.members[0]) + '_' + request.auth.uid));
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Direct messages. One conversation per pair of people, named like a friendship ("<uidA>_<uidB>", ids sorted).
    // Only the two people can read it. Friends can write freely; anyone else starts with a message request (see chatOpen).
    // A message can only be changed by its author: edited (new "enc" and "editedAt") or unsent ("unsent": true with "enc" emptied).
    // Nobody can delete a message. "seen" holds when each person last read the conversation, and you can only change your own.
    function inPair(pid) { return signedIn() && request.auth.uid in pid.split('_'); }
    function friendsInPair(pid) { return exists(/databases/$(database)/documents/friendships/$(pid)); }
    // The other person in a conversation, and whether either of you blocked the other (a block stops new messages both ways).
    function otherInPair(pid) { return pid.split('_')[0] == request.auth.uid ? pid.split('_')[1] : pid.split('_')[0]; }
    // Chats with people who are not (or no longer) your friends are message requests: the person who starts one may send a
    // single message, and the other person opens the chat by accepting ("accepted": true on the conversation). Friends, chats
    // that existed before requests, and accepted chats are open for both. Used for new messages and for the preview.
    function chatOpen(pid) {
      return friendsInPair(pid)
        || !exists(/databases/$(database)/documents/conversations/$(pid))
        || get(/databases/$(database)/documents/conversations/$(pid)).data.get('startedBy', '') == ''
        || get(/databases/$(database)/documents/conversations/$(pid)).data.get('accepted', false) == true;
    }
    function blockedInPair(pid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(otherInPair(pid)))
        || exists(/databases/$(database)/documents/users/$(otherInPair(pid))/blocked/$(request.auth.uid));
    }

    match /conversations/{pid} {
      // Judged on the document's own members (not its name) so the inbox query (members array-contains you) is allowed.
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if inPair(pid)
        && !blockedInPair(pid)
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastEnc', 'lastFrom', 'updatedAt', 'seen', 'startedBy', 'accepted'])
        && request.resource.data.get('startedBy', request.auth.uid) == request.auth.uid
        && (!('accepted' in request.resource.data) || (request.resource.data.accepted == true && friendsInPair(pid)))
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.lastFrom == request.auth.uid
        && request.resource.data.lastText == ''
        && request.resource.data.lastEnc is string && request.resource.data.lastEnc.size() > 0 && request.resource.data.lastEnc.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.seen.keys().hasOnly([request.auth.uid]);
      allow update: if inPair(pid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastEnc', 'lastFrom', 'updatedAt', 'seen', 'accepted'])
        // accepting a request: only the person who did not start it, and only to say yes
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accepted'])
            || (request.resource.data.accepted == true
                && resource.data.get('startedBy', '') != ''
                && resource.data.startedBy != request.auth.uid))
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly([request.auth.uid])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastEnc', 'lastFrom', 'updatedAt'])
            || ((friendsInPair(pid) || resource.data.get('startedBy', '') == '' || resource.data.get('accepted', false) == true)
                && !blockedInPair(pid)
                && request.resource.data.lastFrom == request.auth.uid
                && request.resource.data.lastText == ''
                && request.resource.data.lastEnc is string && request.resource.data.lastEnc.size() > 0 && request.resource.data.lastEnc.size() <= 1000
                && request.resource.data.updatedAt == request.time)
            // editing or unsending your own newest message rewrites the preview and nothing else (the time does not move, so
            // the other person does not get a new unread mark)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastEnc'])
                && resource.data.lastFrom == request.auth.uid
                && !blockedInPair(pid)
                && request.resource.data.lastEnc is string && request.resource.data.lastEnc.size() > 0 && request.resource.data.lastEnc.size() <= 1000));

      match /messages/{messageId} {
        allow read: if inPair(pid);
        allow create: if inPair(pid)
          && chatOpen(pid)
          && !blockedInPair(pid)
          // Messages are end-to-end encrypted (src/e2ee.ts): the server only ever gets "enc", which holds the text, picture and GIF.
          // Plain text, images and GIF links are no longer accepted. The size covers the 300,000-character picture limit in src/messages.ts.
          && request.resource.data.keys().hasOnly(['from', 'createdAt', 'enc'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.enc is string
          && request.resource.data.enc.size() > 0
          && request.resource.data.enc.size() <= 450000
          && request.resource.data.createdAt == request.time;
        // Edit or unsend: only the author, only these fields, and never a message that was already unsent. The plain text, image
        // and gif that messages from before encryption have can only be removed (an edit or an unsend clears them), never changed.
        allow update: if inPair(pid)
          && !blockedInPair(pid)
          && resource.data.from == request.auth.uid
          && !resource.data.get('unsent', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enc', 'editedAt', 'unsent', 'text', 'image', 'gif'])
          && request.resource.data.enc is string
          && request.resource.data.enc.size() <= 450000
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt'])
              || request.resource.data.editedAt == request.time)
          && !('text' in request.resource.data) && !('image' in request.resource.data) && !('gif' in request.resource.data)
          && (request.resource.data.get('unsent', false) == true
              ? request.resource.data.enc == ''
              : (request.resource.data.enc.size() > 0
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unsent'])
                  && request.resource.data.editedAt == request.time));
      }

      // Reactions: one per person per message, named "<messageId>_<uid>". The emoji is encrypted like the message ("enc").
      // You can only add, change or remove your own; either of you can read them.
      match /reactions/{reactionId} {
        allow read: if inPair(pid);
        allow create, update: if inPair(pid)
          && chatOpen(pid)
          && !blockedInPair(pid)
          && request.resource.data.keys().hasOnly(['mid', 'by', 'enc', 'at'])
          && request.resource.data.mid is string
          && request.resource.data.by == request.auth.uid
          && reactionId == request.resource.data.mid + '_' + request.auth.uid
          && request.resource.data.enc is string
          && request.resource.data.enc.size() > 0 && request.resource.data.enc.size() <= 600
          && request.resource.data.at == request.time;
        allow delete: if inPair(pid) && reactionId.split('_')[1] == request.auth.uid;
      }

      // Pinned messages, named after the message. Either of you can pin or unpin. "enc" is a short encrypted copy of the message
      // (its words, who wrote it, when), so the list of pins shows without loading the chat.
      match /pins/{pinId} {
        allow read: if inPair(pid);
        allow create, update: if inPair(pid)
          && chatOpen(pid)
          && !blockedInPair(pid)
          && request.resource.data.keys().hasOnly(['by', 'at', 'enc'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.enc is string
          && request.resource.data.enc.size() > 0 && request.resource.data.enc.size() <= 3000
          && request.resource.data.at == request.time;
        allow delete: if inPair(pid);
      }

      // The quick emoji and nicknames both people see ("settings/shared"). Either friend can change them. The nicknames are
      // keyed by the two people's ids, at most 40 characters each (keep in step with NICK_MAX in src/messages.ts).
      match /settings/{settingsId} {
        allow read: if inPair(pid);
        allow create, update: if inPair(pid)
          && chatOpen(pid)
          && settingsId == 'shared'
          && request.resource.data.keys().hasOnly(['emoji', 'nick', 'theme'])
          && (!('theme' in request.resource.data) || (request.resource.data.theme is string && request.resource.data.theme.size() >= 1 && request.resource.data.theme.size() <= 20))
          && (!('emoji' in request.resource.data)
              || (request.resource.data.emoji is string
                  && request.resource.data.emoji.size() >= 1 && request.resource.data.emoji.size() <= 16))
          && (!('nick' in request.resource.data)
              || (request.resource.data.nick is map
                  && request.resource.data.nick.keys().hasOnly(pid.split('_'))
                  && request.resource.data.nick.get(pid.split('_')[0], '') is string
                  && request.resource.data.nick.get(pid.split('_')[0], '').size() <= 40
                  && request.resource.data.nick.get(pid.split('_')[1], '') is string
                  && request.resource.data.nick.get(pid.split('_')[1], '').size() <= 40));
      }
    }

    // Reports of a message. Messages are end-to-end encrypted, so the report holds only what the reporter chose to send: the words
    // of the message, whether it had a photo or GIF, a reason and a few details. Anyone signed in can report a message from a
    // conversation they are in, about the other person. Nobody can read, change or delete a report from the app: the people
    // who run VibeBook read them in the Firebase console.
    match /messageReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'reported', 'conversation', 'messageId', 'reason', 'excerpt', 'image', 'gif', 'details', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.conversation is string
        && inPair(request.resource.data.conversation)
        && request.resource.data.reported == otherInPair(request.resource.data.conversation)
        && request.resource.data.messageId is string && request.resource.data.messageId.size() <= 40
        && request.resource.data.reason in ['Spam', 'Harassment or bullying', 'Inappropriate content', 'Scam or fraud', 'Something else']
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 500
        && request.resource.data.image is bool && request.resource.data.gif is bool
        && request.resource.data.details is string && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time;
    }

    // Your own say over a chat, at users/{you}/chatPrefs/{otherUid}: when you archived it, muted it until, deleted it ("clearedAt"),
    // marked it read without telling them (readAt), and whether read receipts are on. Only you can read or change it.
    match /users/{uid}/chatPrefs/{otherId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && otherId != uid
        && request.resource.data.keys().hasOnly(['archivedAt', 'mutedUntil', 'clearedAt', 'readAt', 'receipts'])
        && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp)
        && (!('mutedUntil' in request.resource.data) || request.resource.data.mutedUntil is timestamp)
        && (!('clearedAt' in request.resource.data) || request.resource.data.clearedAt is timestamp)
        && (!('readAt' in request.resource.data) || request.resource.data.readAt is timestamp)
        && (!('receipts' in request.resource.data) || request.resource.data.receipts is bool);
    }

    // People you blocked: users/{you}/blocked/{theirUid}. Only you can see or change the list. The person you blocked can
    // read just their own entry (a single get, never the list), so their chat can say they were blocked. While either of you
    // has blocked the other, neither can add a message to their conversation (see blockedInPair above).
    match /users/{uid}/blocked/{otherId} {
      allow get: if isOwner(uid) || (signedIn() && request.auth.uid == otherId);
      allow list, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && otherId != uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // People you restricted: users/{you}/restricted/{theirUid}. Only you can see or change the list, and the other person is
    // never told. The app moves their chat to your message requests and stops reporting what you read to them.
    match /users/{uid}/restricted/{otherId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && otherId != uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // End-to-end encryption keys (src/e2ee.ts).
    // Your public key, publicKeys/{you}: anyone signed in can read it (that is how they encrypt a message to you); only you can write it.
    // It is 65 bytes (an uncompressed P-256 point), 88 characters in base64.
    match /publicKeys/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['key', 'createdAt'])
        && request.resource.data.key is string
        && request.resource.data.key.size() == 88
        && request.resource.data.createdAt == request.time;
    }

    // Your private key, encrypted with your passphrase, at users/{you}/keyBackup/main. It is useless without the passphrase, and
    // only you can read or write it. It is what a new browser or device opens to get your key.
    match /users/{uid}/keyBackup/{backupId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && backupId == 'main'
        && request.resource.data.keys().hasOnly(['v', 'iters', 'salt', 'iv', 'ct', 'createdAt'])
        && request.resource.data.v == 1
        && request.resource.data.iters is int
        && request.resource.data.iters >= 100000
        && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 64
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 400
        && request.resource.data.createdAt == request.time;
    }

    // Active status: one lightweight document per person at presence/{uid}, holding whether they are currently online
    // and when they were last active. Readable only when the owner has Active Status turned on (default true) and their
    // profile is open to the reader. Deleted when the owner turns Active Status off.
    match /presence/{uid} {
      allow read: if isOwner(uid)
        || (signedIn()
            && !profileDeactivated(uid)
            && profileOf(uid).get('activeStatus', true) == true
            && (isFriend(request.auth.uid, uid) || !profileLocked(uid)));
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['online', 'lastActive'])
        && request.resource.data.online is bool
        && request.resource.data.lastActive == request.time;
      allow delete: if isOwner(uid);
    }
  }
}
